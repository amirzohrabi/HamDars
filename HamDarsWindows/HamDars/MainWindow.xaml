<Window x:Class="HamDars.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="هم‌درس | همراه مسیر یادگیری تو" Icon="pack://application:,,,/HamDars;component/Assets/HamDars_Icon.ico" Height="900" Width="1440"
        MinHeight="740" MinWidth="1080" WindowStartupLocation="CenterScreen"
        Background="#0D1520" Foreground="#F7F6FF" FlowDirection="RightToLeft"
        FontFamily="Tahoma" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8CEDE" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="SmallMuted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#98A4B7" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#151E2B" />
            <Setter Property="BorderBrush" Value="#2A3545" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <DataTemplate x:Key="TaskTemplate">
            <Border Background="#101824" BorderBrush="#273343" BorderThickness="1" CornerRadius="13" Padding="12" Margin="0,0,0,9">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="39" Height="39" CornerRadius="12" Background="#282442" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="📚" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Subject}" Foreground="#F7F6FF" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap">
                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Done}" Value="True"><Setter Property="Opacity" Value="0.65"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock Foreground="#98A4B7" FontSize="10" Margin="0,4,0,0"><Run Text="{Binding Category}"/><Run Text="  ·  "/><Run Text="{Binding Duration}"/><Run Text=" دقیقه"/></TextBlock>
                    </StackPanel>
                    <CheckBox Grid.Column="2" IsChecked="{Binding Done, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="TaskDoneChanged" VerticalAlignment="Center" ToolTip="علامت انجام شد" Margin="10,0,0,0" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PlannerTaskTemplate">
            <Border Background="#101824" BorderBrush="#273343" BorderThickness="1" CornerRadius="13" Padding="12" Margin="0,0,0,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="39" Height="39" CornerRadius="12" Background="#282442" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="📚" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Subject}" Foreground="#F7F6FF" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock Foreground="#98A4B7" FontSize="10" Margin="0,4,0,0">
                            <Run Text="{Binding Category}" /><Run Text="  ·  " /><Run Text="{Binding Duration}" /><Run Text=" دقیقه" />
                        </TextBlock>
                        <TextBlock Text="{Binding DisplayTime}" Foreground="#8174E8" FontSize="10" Margin="0,3,0,0" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" IsChecked="{Binding Done, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="TaskDoneChanged" VerticalAlignment="Center" Margin="10,0,8,0" ToolTip="علامت انجام شد" />
                    <Button Grid.Column="3" Content="حذف" Tag="{Binding Id}" Click="DeleteTask_Click" Style="{StaticResource DangerButton}" Padding="11,7" VerticalAlignment="Center" ToolTip="حذف این درس" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Local sign-up / sign-in screen -->
        <Grid x:Name="AuthView" Visibility="Visible" Background="#0D1520" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.02*"/><ColumnDefinition Width="0.98*"/></Grid.ColumnDefinitions>
            <!-- The Viewbox scales the complete original left artwork and every overlay together on resize. -->
            <Border Grid.Column="0" ClipToBounds="True" FlowDirection="LeftToRight" Background="#383DAB">
                <Viewbox Stretch="Fill" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                    <Grid x:Name="ArtworkMotionLayer" Width="870" Height="929" ClipToBounds="True" FlowDirection="LeftToRight">
                        <Image Source="pack://application:,,,/HamDars;component/Assets/HamDars_Login_Artwork_Left.png"
                               Width="870" Height="929" FlowDirection="LeftToRight" Stretch="Fill" />
                    <!-- A soft, moving highlight sweeps across the unmodified artwork. -->
                    <Rectangle x:Name="ArtworkLightSweep" Width="260" HorizontalAlignment="Left"
                               VerticalAlignment="Stretch" IsHitTestVisible="False" Opacity="0.58">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                <GradientStop Color="#18D9DEFF" Offset="0.25" />
                                <GradientStop Color="#68F6F5FF" Offset="0.5" />
                                <GradientStop Color="#18D9DEFF" Offset="0.75" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ArtworkLightSweepTransform" X="-300" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <!-- Subtle pulsing glow; independent of the light sweep. -->
                    <Ellipse x:Name="ArtworkAmbientGlow" Width="230" Height="230"
                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="70,72,0,0"
                             IsHitTestVisible="False" Opacity="0.18">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.5,0.5">
                                <GradientStop Color="#58FFFFFF" Offset="0" />
                                <GradientStop Color="#24D5DFFF" Offset="0.48" />
                                <GradientStop Color="#00D5DFFF" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="ArtworkHaloScale" ScaleX="0.9" ScaleY="0.9" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ArtworkLightSweepTransform"
                                                     Storyboard.TargetProperty="X" From="-300" To="1050"
                                                     Duration="0:0:7" RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="ArtworkAmbientGlow"
                                                     Storyboard.TargetProperty="Opacity" From="0.1" To="0.36"
                                                     Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="ArtworkHaloScale"
                                                     Storyboard.TargetProperty="ScaleX" From="0.88" To="1.13"
                                                     Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever" />
                                    <DoubleAnimation Storyboard.TargetName="ArtworkHaloScale"
                                                     Storyboard.TargetProperty="ScaleY" From="0.88" To="1.13"
                                                     Duration="0:0:2.8" AutoReverse="True" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                    </Grid>
                </Viewbox>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#151E2B" FlowDirection="RightToLeft">
                <Grid MinHeight="760" Margin="34,24">
                    <StackPanel Width="410" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <DockPanel Margin="0,0,0,27">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#62D6B3" DockPanel.Dock="Right" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="فضای شخصی مطالعه" Foreground="#A5AEC0" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="هم‌درس / ویندوز" Foreground="#69788D" FontSize="10" HorizontalAlignment="Left" />
                        </DockPanel>
                        <TextBlock x:Name="AuthHeading" Text="به مسیر خودت خوش اومدی" FontSize="27" FontWeight="Bold" Foreground="#FCFBFF" />
                        <TextBlock x:Name="AuthSubtitle" Text="ثبت‌نام کن تا فضای مخصوص درس و پیشرفتت رو داشته باشی." Foreground="#A5AEC0" FontSize="12" LineHeight="22" Margin="0,7,0,20" />
                        <Grid Background="#0F1722" Margin="0,0,0,19">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="RegisterModeButton" Grid.Column="0" Content="عضویت" Style="{StaticResource PrimaryButton}" Margin="4" Padding="12,10" Click="RegisterMode_Click" />
                            <Button x:Name="LoginModeButton" Grid.Column="1" Content="ورود" Style="{StaticResource SecondaryButton}" Margin="4" Padding="12,10" Click="LoginMode_Click" />
                        </Grid>

                        <StackPanel x:Name="RegisterFields">
                            <TextBlock Text="نام و نام خانوادگی" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NameBox" MaxLength="60" ToolTip="مثلاً: سارا احمدی" />
                            <TextBlock Text="شماره موبایل" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="PhoneBox" MaxLength="18" FlowDirection="LeftToRight" ToolTip="مثلاً: 09121234567" />
                            <TextBlock Text="نام کاربری" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="UsernameBox" MaxLength="24" ToolTip="۳ تا ۲۴ حرف، عدد، خط تیره یا زیرخط" />
                            <TextBlock Text="نام کاربری یکتا انتخاب کن؛ با ورود به این بخش کیف کوچولو باز می‌شه ✨" Foreground="#8390A4" FontSize="10" Margin="0,-5,0,12" />
                            <TextBlock Text="رمز عبور (حداقل ۸ نویسه)" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="RegisterPasswordBox" />
                            <TextBlock Text="پایه یا مقطع تحصیلی" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="GradeCombo" SelectedIndex="4">
                                <ComboBoxItem Content="پایه هفتم" Tag="هفتم" />
                                <ComboBoxItem Content="پایه هشتم" Tag="هشتم" />
                                <ComboBoxItem Content="پایه نهم" Tag="نهم" />
                                <ComboBoxItem Content="پایه دهم" Tag="دهم" />
                                <ComboBoxItem Content="پایه یازدهم" Tag="یازدهم" />
                                <ComboBoxItem Content="پایه دوازدهم" Tag="دوازدهم" />
                                <ComboBoxItem Content="فارغ‌التحصیل / کنکوری" Tag="کنکوری" />
                                <ComboBoxItem Content="سایر" Tag="سایر" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="LoginFields" Visibility="Collapsed">
                            <TextBlock Text="نام کاربری یا شماره موبایل" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="LoginIdentifierBox" MaxLength="60" />
                            <TextBlock Text="رمز عبور" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="LoginPasswordBox" />
                        </StackPanel>

                        <Button x:Name="SubmitAuthButton" Content="ساخت حساب کاربری  ←" Style="{StaticResource PrimaryButton}" Padding="15,13" Margin="0,4,0,0" Click="SubmitAuth_Click" />
                        <TextBlock x:Name="AuthStatus" Foreground="#F2B49B" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <Border Background="#1C2635" BorderBrush="#303B4C" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,17,0,0">
                            <TextBlock Text="اطلاعات این نسخه فقط روی همین کامپیوتر ذخیره می‌شه. رمز عبور به‌صورت هش‌شده نگهداری می‌شه؛ برای ورود آنلاین و همگام‌سازی باید بک‌اند جداگانه وصل کنیم." Foreground="#A5AEC0" FontSize="10" LineHeight="18" />
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Main application -->
        <Grid x:Name="DashboardView" Visibility="Collapsed" Background="#0D1520" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="242"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Column="0" Margin="28,25,28,26" FlowDirection="RightToLeft">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="PageCrumb" Text="فضای مطالعه / داشبورد" Foreground="#9AA6B9" FontSize="11" />
                        <TextBlock x:Name="PageHeading" Text="سلام، قهرمان یادگیری! 👋" Foreground="#F7F6FF" FontSize="25" FontWeight="Bold" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#151E2B" BorderBrush="#2A3545" BorderThickness="1" CornerRadius="11" Padding="12,9" Margin="0,0,10,0">
                            <TextBlock x:Name="TodayLabel" Text="امروز" Foreground="#A5AEC0" FontSize="11" />
                        </Border>
                        <Button Content="خروج" Style="{StaticResource SecondaryButton}" Click="SignOut_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <!-- Home -->
                    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border CornerRadius="22" Padding="24" Margin="0,0,0,16">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7060E2" Offset="0"/><GradientStop Color="#8F7CF4" Offset="1"/></LinearGradientBrush></Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" MaxWidth="700">
                                        <TextBlock Text="✦  مسیر امروزت از همین‌جا شروع می‌شه" Foreground="#E8E3FF" FontSize="11" />
                                        <TextBlock Text="آماده‌ای یه قدم جلوتر بری؟" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,9,0,5" />
                                        <TextBlock Text="قرار نیست همه‌چیز رو یک‌روزه فتح کنی. امروز فقط روی قدم بعدی تمرکز کن." Foreground="#E9E5FF" FontSize="12" LineHeight="22" Margin="0,0,0,13" />
                                        <Button Content="برنامه امروزمو ببین  ←" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="GoPlanner_Click" Background="White" Foreground="#5949C7" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="📚" FontSize="83" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><RotateTransform Angle="-8" /></TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Border CornerRadius="21" Padding="21" BorderBrush="#403751" BorderThickness="1" Margin="0,0,0,16">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#38262D" Offset="0"/><GradientStop Color="#29243F" Offset="0.55"/><GradientStop Color="#1D3637" Offset="1"/></LinearGradientBrush></Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="⚡  شارژ روحیه · هر بار یک تلنگر تازه" Foreground="#C5B8FF" FontSize="10" FontWeight="SemiBold" />
                                        <TextBlock Text="حمله‌ی انگیزشی!" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" Margin="0,7,0,6" />
                                        <TextBlock x:Name="MotivationQuote" Text="قرار نیست امروز از همه جلو بزنی؛ فقط کافیه از دیروزت یه قدم جلوتر باشی." Foreground="#F4F0FF" FontSize="14" FontWeight="SemiBold" LineHeight="26" />
                                        <StackPanel Orientation="Horizontal" Margin="0,13,0,0" VerticalAlignment="Center">
                                            <Button Content="⚡ یه جمله‌ی تازه بده" Style="{StaticResource PrimaryButton}" Padding="14,10" Click="NewMotivation_Click" />
                                            <TextBlock x:Name="MotivationCounter" Text="✦ ۲۰ جمله" Foreground="#A5AEC0" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="MotivationRocket" Grid.Column="1" Text="🚀" FontSize="68" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><TranslateTransform x:Name="MotivationRocketTransform" Y="0" /></TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="4" Margin="0,0,0,16">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,9,0"><StackPanel><TextBlock Text="زمان مطالعه" Foreground="#A5AEC0" FontSize="11"/><TextBlock x:Name="StudyMinutesLabel" Text="۰ دقیقه" FontSize="23" FontWeight="Bold" Margin="0,7,0,2"/><TextBlock Text="مطالعه ثبت‌شده امروز" Foreground="#8792A5" FontSize="10"/></StackPanel></Border>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,9,0"><StackPanel><TextBlock Text="وظایف انجام‌شده" Foreground="#A5AEC0" FontSize="11"/><TextBlock x:Name="TasksDoneLabel" Text="۰/۰" FontSize="23" FontWeight="Bold" Margin="0,7,0,2"/><TextBlock Text="از برنامه امروزت" Foreground="#8792A5" FontSize="10"/></StackPanel></Border>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,9,0"><StackPanel><TextBlock Text="جلسه‌های تمرکز" Foreground="#A5AEC0" FontSize="11"/><TextBlock x:Name="SessionsLabel" Text="۰ جلسه" FontSize="23" FontWeight="Bold" Margin="0,7,0,2"/><TextBlock Text="هر جلسه یه قدمه" Foreground="#8792A5" FontSize="10"/></StackPanel></Border>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0"><StackPanel><TextBlock Text="هدف روزانه" Foreground="#A5AEC0" FontSize="11"/><TextBlock x:Name="GoalProgressLabel" Text="۰٪" FontSize="23" FontWeight="Bold" Margin="0,7,0,2"/><TextBlock Text="با یه جلسه شروع کن" Foreground="#8792A5" FontSize="10"/></StackPanel></Border>
                            </UniformGrid>

                            <Border Style="{StaticResource CardBorder}" Padding="18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="برنامه امروز" FontWeight="Bold" FontSize="15"/><TextBlock x:Name="TaskSummaryLabel" Text="قدم بعدی رو انتخاب کن" Foreground="#98A4B7" FontSize="10" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="＋ افزودن درس" Style="{StaticResource PrimaryButton}" Padding="13,8" Click="AddTask_Click"/></Grid>
                                    <ItemsControl x:Name="HomeTaskList" ItemTemplate="{StaticResource TaskTemplate}" />
                                    <TextBlock x:Name="HomeEmptyLabel" Text="هنوز درسی اضافه نکردی؛ اولین قدم رو با افزودن یک درس بردار." Foreground="#98A4B7" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Padding="18" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Planner -->
                    <ScrollViewer x:Name="PlannerPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="برنامه‌ای بساز که با زمان و انرژی واقعی‌ات جور دربیاد." Foreground="#A5AEC0" FontSize="12" Margin="0,0,0,17" />
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,13"><StackPanel DockPanel.Dock="Right"><TextBlock Text="کارهای امروز" FontWeight="Bold" FontSize="16"/><TextBlock Text="برای هر کار انجام‌شده، مربع کنارش رو بزن." Foreground="#98A4B7" FontSize="10" Margin="0,4,0,0"/></StackPanel><Button Content="＋ افزودن درس" Style="{StaticResource PrimaryButton}" Padding="12,8" Click="AddTask_Click"/></DockPanel>
                                    <UniformGrid Columns="3" Margin="0,0,0,14">
                                        <Border Background="#101824" CornerRadius="11" Padding="12" Margin="0,0,7,0"><StackPanel><TextBlock Text="زمان کل برنامه" Foreground="#98A4B7" FontSize="10"/><TextBlock x:Name="PlannedMinutesLabel" Text="۰ دقیقه" FontWeight="Bold" FontSize="17" Margin="0,6,0,0"/></StackPanel></Border>
                                        <Border Background="#101824" CornerRadius="11" Padding="12" Margin="0,0,7,0"><StackPanel><TextBlock Text="انجام‌شده" Foreground="#98A4B7" FontSize="10"/><TextBlock x:Name="PlannerDoneLabel" Text="۰ کار" FontWeight="Bold" FontSize="17" Margin="0,6,0,0"/></StackPanel></Border>
                                        <Border Background="#101824" CornerRadius="11" Padding="12"><StackPanel><TextBlock Text="باقی‌مانده" Foreground="#98A4B7" FontSize="10"/><TextBlock x:Name="PlannerRemainingLabel" Text="۰ کار" FontWeight="Bold" FontSize="17" Margin="0,6,0,0"/></StackPanel></Border>
                                    </UniformGrid>
                                    <ItemsControl x:Name="PlannerTaskList" ItemTemplate="{StaticResource PlannerTaskTemplate}" />
                                    <TextBlock x:Name="PlannerEmptyLabel" Text="برنامه‌ات خالیه. با «افزودن درس» اولین کار رو بساز." Foreground="#98A4B7" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Padding="18" Visibility="Collapsed" />
                                    <Button Content="پاک‌کردن تیک‌های امروز" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="ResetTasks_Click" />
                                </StackPanel>
                            </Border>
                            <Border Background="#1C2635" CornerRadius="12" Padding="14"><TextBlock Text="یادآوری: برنامه قرار نیست تو رو تحت فشار بذاره. بین درس‌ها استراحت کن و برنامه رو با شرایط واقعی خودت تنظیم کن." Foreground="#A5AEC0" FontSize="11" LineHeight="21"/></Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Focus timer -->
                    <ScrollViewer x:Name="FocusPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="26" Margin="0,0,12,0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="جلسه تمرکز تو" Foreground="#A5AEC0" FontSize="11" HorizontalAlignment="Center"/>
                                    <Grid Width="280" Height="280" Margin="0,24,0,18">
                                        <Ellipse Stroke="#2A3545" StrokeThickness="12" />
                                        <Ellipse Stroke="#8273EF" StrokeThickness="12" StrokeDashArray="5 2" Margin="2" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="TimerText" Text="۲۵:۰۰" FontSize="47" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="TimerKindLabel" Text="زمان تمرکز" Foreground="#A5AEC0" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="TimerStatusLabel" Text="هر وقت آماده‌ای شروع کن" Foreground="#A5AEC0" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,13"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="TimerStartButton" Content="▶ شروع جلسه" Style="{StaticResource PrimaryButton}" Padding="18,11" Click="TimerStart_Click"/><Button Content="↺ شروع مجدد" Style="{StaticResource SecondaryButton}" Margin="9,5,0,0" Click="TimerReset_Click"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,17,0,0"><Button Content="تمرکز ۲۵ دقیقه" Tag="25" Style="{StaticResource SecondaryButton}" Margin="3" Click="TimerPreset_Click"/><Button Content="استراحت ۵ دقیقه" Tag="5" Style="{StaticResource SecondaryButton}" Margin="3" Click="TimerPreset_Click"/><Button Content="تمرکز ۴۵ دقیقه" Tag="45" Style="{StaticResource SecondaryButton}" Margin="3" Click="TimerPreset_Click"/></StackPanel>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="چند نکته برای تمرکز بهتر" FontSize="15" FontWeight="Bold" Margin="0,0,0,15"/><TextBlock Text="①  فقط یک هدف انتخاب کن" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock Text="قبل از شروع مشخص کن تا پایان جلسه می‌خوای به کجا برسی." Foreground="#A5AEC0" FontSize="11" LineHeight="20" Margin="0,0,0,15"/><TextBlock Text="②  مزاحمت‌ها رو کم کن" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock Text="اعلان‌های غیرضروری رو کنار بذار و وسایل لازم رو آماده کن." Foreground="#A5AEC0" FontSize="11" LineHeight="20" Margin="0,0,0,15"/><TextBlock Text="③  استراحت هم بخشی از برنامه‌ست" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock Text="بعد از تمرکز، چند دقیقه به ذهنت فرصت بازیابی بده." Foreground="#A5AEC0" FontSize="11" LineHeight="20"/></StackPanel></Border>
                                <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="جلسه‌های انجام‌شده" Foreground="#A5AEC0" FontSize="11"/><TextBlock x:Name="FocusSessionsLabel" Text="۰ جلسه" FontSize="25" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="هر جلسه کامل‌شده اینجا ثبت می‌شه." Foreground="#98A4B7" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Progress -->
                    <ScrollViewer x:Name="ProgressPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="پیشرفتت رو برای شناختن عادت‌ها بررسی کن، نه برای سخت‌گیری به خودت." Foreground="#A5AEC0" FontSize="12" Margin="0,0,0,17"/>
                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0"><StackPanel><TextBlock Text="زمان ثبت‌شده امروز" Foreground="#A5AEC0" FontSize="10"/><TextBlock x:Name="ProgressMinutesLabel" Text="۰ دقیقه" FontSize="22" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Border>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0"><StackPanel><TextBlock Text="کارهای انجام‌شده" Foreground="#A5AEC0" FontSize="10"/><TextBlock x:Name="ProgressTasksLabel" Text="۰" FontSize="22" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Border>
                                <Border Style="{StaticResource CardBorder}" Margin="0"><StackPanel><TextBlock Text="جلسه‌های تمرکز" Foreground="#A5AEC0" FontSize="10"/><TextBlock x:Name="ProgressSessionsLabel" Text="۰" FontSize="22" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel></Border>
                            </UniformGrid>
                            <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="پیشرفت امروز" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/><TextBlock x:Name="ProgressBarCaption" Text="۰٪ از هدف روزانه" Foreground="#A5AEC0" FontSize="11"/><ProgressBar x:Name="GoalProgressBar" Minimum="0" Maximum="100" Value="0" Height="12" Background="#283243" Foreground="#8273EF" BorderThickness="0" Margin="0,10,0,8"/><TextBlock Text="قدم‌های کوچک تو هم ارزشمندند؛ آمار برای کمک به برنامه‌ریزیه، نه برای مقایسه با دیگران." Foreground="#A5AEC0" FontSize="11" LineHeight="21"/></StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Settings -->
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="هم‌درس رو با سبک مطالعه خودت هماهنگ کن." Foreground="#A5AEC0" FontSize="12" Margin="0,0,0,17"/>
                            <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="تنظیمات مطالعه" FontSize="15" FontWeight="Bold" Margin="0,0,0,15"/><TextBlock Text="هدف مطالعه روزانه" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="DailyGoalCombo" SelectedIndex="1" SelectionChanged="DailyGoal_SelectionChanged"><ComboBoxItem Content="۱ ساعت" Tag="60"/><ComboBoxItem Content="۲ ساعت" Tag="120"/><ComboBoxItem Content="۳ ساعت" Tag="180"/><ComboBoxItem Content="۴ ساعت" Tag="240"/><ComboBoxItem Content="۵ ساعت" Tag="300"/><ComboBoxItem Content="۶ ساعت" Tag="360"/><ComboBoxItem Content="۷ ساعت" Tag="420"/><ComboBoxItem Content="۸ ساعت" Tag="480"/><ComboBoxItem Content="۹ ساعت" Tag="540"/><ComboBoxItem Content="۱۰ ساعت" Tag="600"/><ComboBoxItem Content="۱۱ ساعت" Tag="660"/><ComboBoxItem Content="۱۲ ساعت" Tag="720"/></ComboBox><TextBlock Text="پروفایل فعال" Style="{StaticResource FieldLabel}" Margin="0,8,0,2"/><TextBlock x:Name="SettingsProfileLabel" Text="دانش‌آموز" Foreground="#A5AEC0" FontSize="12" Margin="0,5,0,12"/><Button Content="خروج از حساب" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="SignOut_Click"/></StackPanel></Border>
                            <Border Background="#1C2635" CornerRadius="12" Padding="14"><TextBlock Text="نسخه ویندوزی آزمایشی هم‌درس؛ اطلاعات روی همین کامپیوتر ذخیره می‌شود و هنوز همگام‌سازی ابری ندارد." Foreground="#A5AEC0" FontSize="11" LineHeight="21"/></Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Background="#151E2B" BorderBrush="#2A3545" BorderThickness="1,0,0,0" Padding="17,27" FlowDirection="RightToLeft">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,29">
                            <Border Background="#090D2A" Width="42" Height="42" CornerRadius="14" Margin="0,0,10,0" ClipToBounds="True"><Image Source="pack://application:,,,/HamDars;component/Assets/HamDars_LogoMark.png" Stretch="Uniform"/></Border>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="هم‌درس" Foreground="#F7F6FF" FontSize="20" FontWeight="Bold"/><TextBlock Text="همراه مسیر یادگیری تو" Foreground="#98A4B7" FontSize="10"/></StackPanel>
                        </StackPanel>
                        <TextBlock Text="فضای مطالعه" Foreground="#7E8BA0" FontSize="10" Margin="12,0,0,8"/>
                        <Button x:Name="NavHome" Content="⌂    داشبورد" Style="{StaticResource NavButton}" Click="NavHome_Click" Background="#30294F" Foreground="#BDB4FF"/>
                        <Button x:Name="NavPlanner" Content="▦    برنامه‌ریزی درسی" Style="{StaticResource NavButton}" Click="NavPlanner_Click"/>
                        <Button x:Name="NavFocus" Content="◷    تایمر تمرکز" Style="{StaticResource NavButton}" Click="NavFocus_Click"/>
                        <Button x:Name="NavProgress" Content="▥    گزارش پیشرفت" Style="{StaticResource NavButton}" Click="NavProgress_Click"/>
                        <TextBlock Text="حساب کاربری" Foreground="#7E8BA0" FontSize="10" Margin="12,23,0,8"/>
                        <Button x:Name="NavSettings" Content="⚙    تنظیمات" Style="{StaticResource NavButton}" Click="NavSettings_Click"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Background="#232A3B" CornerRadius="15" Padding="13" Margin="0,20,0,0">
                        <StackPanel><Border Background="#35304E" CornerRadius="9" Width="30" Height="30" HorizontalAlignment="Right"><TextBlock Text="✦" Foreground="#BDB4FF" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="قدم‌های کوچیک، نتیجه‌های بزرگ" Foreground="#E8E5F7" FontWeight="SemiBold" FontSize="11" Margin="0,10,0,0"/><TextBlock Text="لازم نیست هر روز عالی باشی؛ فقط کافیه ادامه بدی." Foreground="#98A4B7" FontSize="10" LineHeight="18" Margin="0,5,0,0"/><Button Content="یه یادآوری خوب ✨" Style="{StaticResource SecondaryButton}" Click="NewMotivation_Click" Padding="8,8" Margin="0,11,0,0"/></StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" BorderBrush="#2A3545" BorderThickness="0,1,0,0" Padding="0,15,0,0" Margin="0,0,0,18">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#F9D6B8" Width="38" Height="38" CornerRadius="12"><TextBlock x:Name="ProfileInitial" Text="هـ" Foreground="#80543B" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="10,0,7,0" VerticalAlignment="Center"><TextBlock x:Name="ProfileNameLabel" Text="دانش‌آموز" Foreground="#F7F6FF" FontWeight="SemiBold" FontSize="11"/><TextBlock x:Name="ProfileGradeLabel" Text="مقطع تحصیلی" Foreground="#98A4B7" FontSize="10" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="2" Content="↪" Style="{StaticResource SecondaryButton}" Padding="8,6" Click="SignOut_Click" ToolTip="خروج"/></Grid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Add task modal -->
            <Grid x:Name="TaskModal" Grid.ColumnSpan="2" Background="#AA000000" Visibility="Collapsed" Panel.ZIndex="10" FlowDirection="RightToLeft">
                <Border Background="#151E2B" BorderBrush="#394456" BorderThickness="1" CornerRadius="20" Padding="23" Width="430" MaxHeight="660" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <DockPanel Margin="0,0,0,18"><TextBlock Text="افزودن به برنامه" FontSize="19" FontWeight="Bold"/><Button Content="✕" Style="{StaticResource SecondaryButton}" Padding="8,5" DockPanel.Dock="Left" Click="CloseTaskModal_Click"/></DockPanel>
                        <TextBlock Text="نام درس یا فعالیت" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TaskSubjectBox" MaxLength="70" ToolTip="مثلاً: زیست‌شناسی، فصل دوم"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="مدت (دقیقه)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TaskDurationBox" Text="45" MaxLength="3"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ساعت شروع" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TaskTimeBox" Text="17:00" MaxLength="5"/></StackPanel></Grid>
                        <TextBlock Text="دسته‌بندی" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="TaskCategoryCombo" SelectedIndex="1"><ComboBoxItem Content="ریاضی" Tag="ریاضی"/><ComboBoxItem Content="علوم و زیست" Tag="علوم و زیست"/><ComboBoxItem Content="ادبیات" Tag="ادبیات"/><ComboBoxItem Content="زبان" Tag="زبان"/><ComboBoxItem Content="سایر درس‌ها" Tag="سایر درس‌ها"/></ComboBox>
                        <TextBlock x:Name="TaskFormError" Foreground="#F2B49B" FontSize="11" Margin="0,0,0,5"/>
                        <Button Content="افزودن درس" Style="{StaticResource PrimaryButton}" Click="SaveTask_Click"/><Button Content="انصراف" Style="{StaticResource SecondaryButton}" Click="CloseTaskModal_Click"/>
                    </StackPanel></ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="ToastBorder" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Background="#27223E" CornerRadius="12" Padding="18,10" Visibility="Collapsed" Panel.ZIndex="20">
            <TextBlock x:Name="ToastText" Text="پیام" Foreground="White" FontSize="12" />
        </Border>
    </Grid>
</Window>
