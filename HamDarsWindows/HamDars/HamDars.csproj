    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HamDars</RootNamespace>
    <AssemblyName>HamDars</AssemblyName>
    <Platforms>AnyCPU;x64;x86</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\HamDars_Login_Artwork.png" />
    <Resource Include="Assets\HamDars_Login_Artwork_Left.png" />
    <Resource Include="Assets\HamDars_Logo.png" />
    <Resource Include="Assets\HamDars_LogoMark.png" />
    <Resource Include="Assets\HamDars_Icon.ico" />
  </ItemGroup>
</Project>
